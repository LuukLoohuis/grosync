{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grosync",
  "compatibility_date": "2026-09-09",
  "assets": {
    // Vite schrijft de gebouwde app hierheen; er is geen Worker-script,
    // dit is een statische site.
    "directory": "./dist",
    // React Router doet de routing in de browser, dus elk pad dat geen
    // bestand is moet index.html terugkrijgen met een 200.
    "not_found_handling": "single-page-application"
  }
}
